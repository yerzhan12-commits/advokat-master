# Anthropic API (используется api/case-wizard.js)
ANTHROPIC_API_KEY=

# Vercel KV (используется api/_lib/cases.js и всеми api/lawyer/*, api/admin/*)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Пароль для /api/admin/create-lawyer (ручное создание аккаунта адвоката —
# самостоятельной регистрации нет, онбординг всегда через Ержана по договору).
ADMIN_PASSWORD=

# Текущий МРП (месячный расчётный показатель) в тенге — используется в
# api/_lib/legal-calc.js для расчёта госпошлины и других порогов, завязанных
# на МРП. МЕНЯЕТСЯ РАЗ В ГОД вместе с республиканским бюджетом, обновлять
# значение при смене года (деплой кода не нужен). На 2026 год: 4325.
MRP_KZT=

# Заглушка для локального прогона без реальных вызовов Claude API — та же
# идея, что MOCK_WIZARD в zhaloba-master. НЕ ставить в проде.
MOCK_CASE_WIZARD=
